# Any OpenAI-compatible endpoint works (Groq, Gemini, OpenAI, OpenRouter, ...).
# Copy this file to .env and fill in. Check your provider's docs for current model names.

# Example: Groq (free tier)
LLM_API_KEY=your_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Example: Gemini via its OpenAI-compatible endpoint
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=<a current gemini flash model>

# Optional overrides
# EMBED_MODEL=intfloat/multilingual-e5-small
# RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
